# Copy this file to .env and paste your Discord webhook URL below.
# .env is ignored by git, so the URL never gets pushed to GitHub.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# The SEC asks everyone who downloads its filings to give a name and email.
# Used by the insider-trades feature. Nothing is sent anywhere else.
SEC_USER_AGENT=Your Name your.email@example.com
